#4. To perform Association Rule Mining and Clustering using R. 
 #Program: Association Rule Mining  
install.packages("arules") 
library(arules)  
transactions <- read.transactions( 
  textConnection( 
    "Milk,Bread 
     Milk,Butter 
     Bread,Butter 
     Milk,Bread,Butter 
     Milk,Bread" 
  ), 
  format = "basket", 
  sep = "," 
) 
inspect(transactions) 
rules <- apriori( 
  transactions, 
  parameter = list( 
    support = 0.4, 
    confidence = 0.7 
  ) 
)  
inspect(rules) 
             summary(rules)


#Program: Clustering 
data <- data.frame( 
X = c(2, 3, 3, 5, 6, 7, 8, 9), 
Y = c(3, 4, 5, 7, 8, 9, 10, 11) 
) 
print(data)  
result <- kmeans(data, centers = 2)  
print(result) 
print(result$cluster)  
print(result$centers) 
plot( 
data, 
col = result$cluster, 
pch = 19, 
main = "K-Means Clustering", 
xlab = "X", 
ylab = "Y" 
)  
points( 
result$centers, 
col = "red", 
pch = 8, 
cex = 2 
)